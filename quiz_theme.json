{
	"defaults":
    {
        "font":
        {
            "name": "noto_sans_jp",
            "font_size": 16
        }
    },
	"window": {
		"font": { "name": "noto_sans_jp", "size": "20" },
		"colours": { 
			"dark_bg": "#F0F4F8", 
			"title_bar": "#B0C4DE", 
			"title_text": "#1A202C" 
		},
		"title_bar": { "font": { "name": "noto_sans_jp", "size": "20" } }
	},
	"message_window": {
		"font": { "name": "noto_sans_jp", "size": "35" },
		"title_bar": { "font": { "name": "noto_sans_jp", "size": "20" } }
	},

	"@quiz_window": {
		"font": { "name": "noto_sans_jp", "size": "20" },
		"colours": { 
			"dark_bg": "#FFFFFF",
			"title_bar": "#4A90E2",
			"title_text": "#FFFFFF" 
		},
		"title_bar": { "font": { "name": "noto_sans_jp", "size": "20" } }
	},

	"@quiz_label": { "font": { "name": "noto_sans_jp", "size": "20" }, "colours": { "normal_text": "#2D3748" } },
	"@quiz_entry": { "font": { "name": "noto_sans_jp", "size": "20" } },
	"@quiz_button": { "font": { "name": "noto_sans_jp", "size": "20" } },
	"#quiz_question_label": { "font": { "name": "noto_sans_jp", "size": "28" }, "colours": { "normal_text": "#1A202C" } },
	"#quiz_answer_entry": { "font": { "name": "noto_sans_jp", "size": "24" } },
	"#answered_countries_label": { 
		"font": { "name": "noto_sans_jp", "size": "20" }, 
		"colours": { "normal_text": "#4A5568" }
	},

	"@quiz_textbox": { 
		"font": { "name": "noto_sans_jp", "size": "20" }, 
		"colours": { 
			"normal_text": "#2D3748",
			"dark_bg": "#FFFFFF" 
		} 
	},

	"#answered_countries_textbox": { 
		"font": { "name": "noto_sans_jp", "size": "20" }, 
		"colours": { 
			"normal_text": "#4A5568", 
			"dark_bg": "#FFFFFF" 
		}
	},

	"#submit_answer_button": { 
		"colours": { 
			"normal_bg": "#007bff", 
			"hovered_bg": "#0069d9", 
			"normal_text": "#FFFFFF" 
		} 
	},
	"#quiz_button": { "colours": { "normal_bg": "#28a745", "hovered_bg": "#218838", "normal_text": "#ffffff" } },
	
	"#flag_quiz_window":{
		"colours": { 
			"dark_bg": "#FFFFFF", 
			"title_bar": "#4A90E2", 
			"title_text": "#FFFFFF" 
		}
	},

	"@correct_message_window": {
		"colours": {
			"dark_bg": "#E0FFE0",
			"title_bar": "#008000",
			"title_text": "#FFFFFF"
		},
		"font": { "name": "noto_sans_jp", "size": "20" }
	},
	"@correct_message_window_#text_box": {
		"colours": {
			"dark_bg": "#E0FFE0",
			"normal_text": "#000000"
		},
		"font": { "name": "noto_sans_jp", "size": "20" }
	},
	"@wrong_message_window": {
		"colours": {
			"dark_bg": "#FFE0E0",
			"title_bar": "#A00000",
			"title_text": "#FFFFFF"
		},
		"font": { "name": "noto_sans_jp", "size": "20" }
	},
	"@wrong_message_window_#text_box": {
		"colours": {
			"dark_bg": "#FFE0E0",
			"normal_text": "#000000"
		},
		"font": { "name": "noto_sans_jp", "size": "20" }
	},
	"@clear_message_window": {
		"colours": {
			"dark_bg": "#2F4F4F",
			"title_bar": "#FFD700",
			"title_text": "#000000"
		},
		"font": { "name": "noto_sans_jp", "size": "20" }
	},
	"@clear_message_window_#text_box": {
		"colours": {
			"dark_bg": "#2F4F4F",
			"normal_text": "#FFFFFF"
		},
		"font": { "name": "noto_sans_jp", "size": "20" }
	},

	"@info_message_window_#text_box": {
		"colours": {
			"dark_bg": "#F0F0F0",
			"normal_text": "#000000"
		},
		"font": { "name": "noto_sans_jp", "size": "20" }
	},
	"@message_ok_button": {
		"colours": {
			"normal_bg": "#606060",
			"hover_bg": "#707070",
			"normal_text": "#FFFFFF"
		},
		"font": {
			"name": "noto_sans_jp",
			"size": "18"
		}
	},

	"#clear_title": {
        "font": { "name": "noto_sans_jp", "size": "80" }, 
        "colours": { 
            "normal_text": "#FFFFFF", 
            "shadow": "#FFD700"      
        },
        "misc": {
            "shadow_width": "5",     
            "shadow_offset": "3,3"   
        }
    }
}